{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "VITE_SUPABASE_PROJECT_ID": "@supabase_project_id",
    "VITE_SUPABASE_ANON_KEY": "@supabase_anon_key"
  }
}
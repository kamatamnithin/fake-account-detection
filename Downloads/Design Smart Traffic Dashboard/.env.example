# Copy this file to `.env` and fill in your Supabase project credentials
# used by the edge function during local development.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-xxx

# Frontend environment variables (used by vite)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# (Optional) You can still override the variables above by editing
# `utils/supabase/info.tsx` directly; the file falls back to the
# values defined there if the VITE_ variables are not set.

